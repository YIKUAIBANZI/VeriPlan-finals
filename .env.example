# Reference only: the application reads process environment, not this file.
APP_MODE=demo
# Keep false until offline acceptance passes and an operator explicitly authorizes a real smoke.
ENABLE_LIVE_WORKFLOW=false
DATABASE_URL=sqlite:///veriplan.db
# Model and search adapters are implemented and MockTransport-tested.
# Live writes additionally require APP_MODE=live, this flag, and both provider keys.
# Never commit actual credentials.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=15
# Optional comma-separated hostnames. Do not include schemes or paths.
TAVILY_TRUSTED_DOMAINS=
TAVILY_BLOCKED_DOMAINS=
